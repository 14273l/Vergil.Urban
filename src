local SilentAim = {
    Enabled     = false,
    FOV         = 250,
    TargetPart  = "Head",
    VisibleOnly = true,
    ShowCircle  = true,
    HitChance   = 100,
}

local SA_State = { Fire = nil, Circle = nil, Hooked = false }

local SA_Ray = RaycastParams.new()
SA_Ray.FilterType     = Enum.RaycastFilterType.Exclude
SA_Ray.IgnoreWater    = true
SA_Ray.CollisionGroup = "Bullet"

local function SA_Exclude()
    local t = { SA_Camera }
    if SA_LP.Character then table.insert(t, SA_LP.Character) end
    for _, n in { "FX", "ClientHitboxes" } do
        local i = workspace:FindFirstChild(n)
        if i then table.insert(t, i) end
    end
    return t
end

local function SA_Visible(from, to)
    SA_Ray.FilterDescendantsInstances = SA_Exclude()
    local dir = to - from
    local hit = workspace:Raycast(from, dir, SA_Ray)
    if not hit then return true end
    return (hit.Position - from).Magnitude >= dir.Magnitude - 1
end

local function SA_Target()
    local best, bestDist = nil, SilentAim.FOV
    local center = SA_Camera.ViewportSize / 2
    local camPos = SA_Camera.CFrame.Position
    for _, player in SA_Players:GetPlayers() do
        if player == SA_LP then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(SilentAim.TargetPart)
        if not part then continue end
        local sp, onScreen = SA_Camera:WorldToViewportPoint(part.Position)
        if not onScreen or sp.Z <= 0 then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d >= bestDist then continue end
        if SilentAim.VisibleOnly and not SA_Visible(camPos, part.Position) then continue end
        bestDist = d
        best = { char = char, pos = part.Position, player = player }
    end
    return best
end

local function SA_ProcessArgs(args, tgt)
    if not tgt then return end
    if typeof(args[1]) == "Vector3" then
        args[2] = (tgt.pos - args[1]).Unit
    end
    if typeof(args[11]) == "Vector3" and typeof(args[12]) == "Vector3" then
        args[12] = (tgt.pos - args[11]).Unit
    end
    if typeof(args[13]) == "Vector3" then
        args[13] = tgt.pos
    end
    if type(args[3]) ~= "string" then
        args[3] = tgt.char
        args[4] = SilentAim.TargetPart
        args[5] = tgt.pos
    end
end

local function SA_MakeCircle()
    if SA_State.Circle then return end
    if not Drawing or not Drawing.new then return end
    local ok, circle = pcall(function() return Drawing.new("Circle") end)
    if not ok or not circle then return end
    circle.Color        = Color3.new(1, 1, 1)
    circle.Thickness    = 1.5
    circle.NumSides     = 64
    circle.Filled       = false
    circle.Transparency = 0.85
    circle.Visible      = false
    SA_State.Circle = circle
end

local function SA_InstallHook()
    if SA_State.Hooked then return end
    task.spawn(function()
        local remotes = SA_RS:WaitForChild("Remotes", 15)
        if not remotes then warn("[SA] Remotes not found"); return end
        local fire = remotes:WaitForChild("Fire", 15)
        if not fire then warn("[SA] Fire not found"); return end
        SA_State.Fire = fire

        local oldFire
        local ok, err = pcall(function()
            oldFire = hookfunction(fire.FireServer, function(self, ...)
                if not rawequal(self, SA_State.Fire) then
                    return oldFire(self, ...)
                end
                if not SilentAim.Enabled then
                    return oldFire(self, ...)
                end
                local args = { ... }
                local n = select("#", ...)
                local tgt  = SA_Target()
                if not tgt then
                    return oldFire(self, table.unpack(args, 1, n))
                end
                if SilentAim.HitChance < 100 then
                    if math.random() * 100 > SilentAim.HitChance then
                        return oldFire(self, table.unpack(args, 1, n))
                    end
                end
                SA_ProcessArgs(args, tgt)
                return oldFire(self, table.unpack(args, 1, n))
            end)
        end)
        if ok then SA_State.Hooked = true
        else warn("[SA] hookfunction failed: " .. tostring(err)) end
    end)
end

task.spawn(function()
    SA_MakeCircle()
    SA_Run.RenderStepped:Connect(function()
        local c = SA_State.Circle
        if not c then SA_MakeCircle(); c = SA_State.Circle; if not c then return end end
        local show = SilentAim.Enabled and SilentAim.ShowCircle
        c.Visible = show
        if show then
            c.Position = SA_UIS:GetMouseLocation()
            c.Radius   = SilentAim.FOV
        end
    end)
end)

