    local function Build(part)
        local adorn = Instance.new("BoxHandleAdornment")
        adorn.Size = part.Name == "Head"
            and (Vector3.new(1, 1, 1) + Vector3.new(0.2, 0.2, 0.2))
            or (part.Size + Vector3.new(0.05, 0.05, 0.05))
        adorn.Adornee      = part
