local ModelChanger = {}
do
    local enabled = false
    local connections = {}
    local renderConn = nil
    local maintenanceConn = nil
    local hiddenParts = {}
    local equipDebounce = false

    local MODELS = {
        { name = "Tung Tung Sahur", id = 138151705692565, scale = 1.3 },
        { name = "Minion", id = 164495503, scale = 1.0 },
    }

    local selectedModelIndex = 1
    local currentModelName = MODELS[1].name

    local TAG = "ModelChanger_" .. tostring(os.time())
    local HIDE_TAG = "HiddenPart_" .. tostring(os.time())

    local function getSelected()
        return MODELS[selectedModelIndex]
    end

    local function getAnchor(character)
        if not character then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.RootPart then return humanoid.RootPart end
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then return root end
        local primary = character.PrimaryPart
        if primary then return primary end
        local upper = character:FindFirstChild("UpperTorso")
        if upper then return upper end
        local torso = character:FindFirstChild("Torso")
        if torso then return torso end
        local head = character:FindFirstChild("Head")
        if head then return head end
        return nil
    end

    local function loadAsset(id)
        local ok, result = pcall(function()
            return InsertService:LoadAsset(id)
        end)
        if ok and result then return result end

        if typeof(game.GetObjects) == "function" then
            local ok2, objs = pcall(function()
                return game:GetObjects("rbxassetid://" .. id)
            end)
            if ok2 and objs and #objs > 0 then
                local model = Instance.new("Model")
                for _, o in ipairs(objs) do o.Parent = model end
                return model
            end
        end

        if typeof(game.HttpGet) == "function" then
            local ok3, xml = pcall(function()
                return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. id)
            end)
            if ok3 and type(xml) == "string" and #xml > 0 then
                local ok4, model = pcall(function()
                    return InsertService:Insert(xml)
                end)
                if ok4 and model then return model end
            end
        end

        return nil
    end

    local function clearOld(character)
        if character then
            for _, d in ipairs(character:GetDescendants()) do
                if d:GetAttribute(TAG) then d:Destroy() end
            end
        end
        for _, d in ipairs(workspace:GetChildren()) do
            if d:GetAttribute(TAG) then d:Destroy() end
        end
    end

    local function shouldSkip(inst)
        local cur = inst
        while cur and cur ~= game do
            if cur:GetAttribute(TAG) then return true end
            if cur:IsA("Tool") then return true end
            cur = cur.Parent
        end
        return false
    end

    local function hideOne(inst)
        if shouldSkip(inst) then return end

        if inst:IsA("BasePart") then
            if hiddenParts[inst] == nil then
                hiddenParts[inst] = inst.Transparency
            end
            inst.Transparency = 1
            inst:SetAttribute(HIDE_TAG, true)
            for _, child in ipairs(inst:GetChildren()) do
                if (child:IsA("Decal") or child:IsA("Texture")) and not shouldSkip(child) then
                    if hiddenParts[child] == nil then
                        hiddenParts[child] = child.Transparency
                    end
                    child.Transparency = 1
                    child:SetAttribute(HIDE_TAG, true)
                end
            end
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            if hiddenParts[inst] == nil then
                hiddenParts[inst] = inst.Transparency
            end
            inst.Transparency = 1
            inst:SetAttribute(HIDE_TAG, true)
        elseif inst:IsA("Accessory") or inst:IsA("Hat") then
            for _, p in ipairs(inst:GetDescendants()) do
                if not shouldSkip(p) and (p:IsA("BasePart") or p:IsA("Decal") or p:IsA("Texture")) then
                    if hiddenParts[p] == nil then
                        hiddenParts[p] = p.Transparency
                    end
                    p.Transparency = 1
                    p:SetAttribute(HIDE_TAG, true)
                end
            end
        end
    end

    local function hideAvatar(character)
        for _, d in ipairs(character:GetDescendants()) do
            hideOne(d)
        end
        local conn = character.DescendantAdded:Connect(function(d)
            task.wait(0.05)
            if enabled then hideOne(d) end
        end)
        table.insert(connections, conn)
    end

    local function rehideAvatar(character)
        for _, d in ipairs(character:GetDescendants()) do
            if not shouldSkip(d) then
                if d:IsA("BasePart") and d.Transparency ~= 1 then
                    hideOne(d)
                elseif (d:IsA("Decal") or d:IsA("Texture")) and d.Transparency ~= 1 then
                    hideOne(d)
                end
            end
        end
    end

    local function restoreAvatar()
        for part, original in pairs(hiddenParts) do
            if part and part.Parent then
                pcall(function() part.Transparency = original end)
            end
        end
        hiddenParts = {}
    end

    local function scaleModel(parts, factor)
        if factor == 1 then return end
        local minV, maxV = nil, nil
        for _, p in ipairs(parts) do
            local cf, size = p.CFrame, p.Size
            local corners = {
                cf * Vector3.new(-size.X/2, -size.Y/2, -size.Z/2),
                cf * Vector3.new( size.X/2, -size.Y/2, -size.Z/2),
                cf * Vector3.new(-size.X/2,  size.Y/2, -size.Z/2),
                cf * Vector3.new( size.X/2,  size.Y/2, -size.Z/2),
                cf * Vector3.new(-size.X/2, -size.Y/2,  size.Z/2),
                cf * Vector3.new( size.X/2, -size.Y/2,  size.Z/2),
                cf * Vector3.new(-size.X/2,  size.Y/2,  size.Z/2),
                cf * Vector3.new( size.X/2,  size.Y/2,  size.Z/2),
            }
            for _, c in ipairs(corners) do
                minV = minV and Vector3.new(math.min(minV.X,c.X), math.min(minV.Y,c.Y), math.min(minV.Z,c.Z)) or c
                maxV = maxV and Vector3.new(math.max(maxV.X,c.X), math.max(maxV.Y,c.Y), math.max(maxV.Z,c.Z)) or c
            end
        end
        local center = (minV + maxV) / 2
        for _, p in ipairs(parts) do
            p.Size = p.Size * factor
            local offsetFromCenter = p.Position - center
            p.Position = center + offsetFromCenter * factor
        end
    end

    local function equip(character)
        if equipDebounce then return end
        equipDebounce = true

        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid then equipDebounce = false; return end
        local root = getAnchor(character)
        if not root then equipDebounce = false; return end

        task.wait(0.3)
        if not enabled then equipDebounce = false; return end
        if humanoid.Health <= 0 then equipDebounce = false; return end

        clearOld(character)
        hideAvatar(character)

        local modelData = getSelected()
        local asset = loadAsset(modelData.id)
        if not asset then
            warn("[ModelChanger] Failed to load asset " .. modelData.id)
            equipDebounce = false
            return
        end

        asset:SetAttribute(TAG, true)
        for _, d in ipairs(asset:GetDescendants()) do
            d:SetAttribute(TAG, true)
        end

        local parts = {}
        local accessory = asset:FindFirstChildWhichIsA("Accessory", true)
        if accessory then
            local handle = accessory:FindFirstChild("Handle")
            if handle then table.insert(parts, handle) end
        else
            for _, d in ipairs(asset:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(parts, d) end
            end
        end

        if #parts == 0 then
            warn("[ModelChanger] Asset contains no parts.")
            asset:Destroy()
            equipDebounce = false
            return
        end

        for _, p in ipairs(parts) do
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.Massless = true
        end

        scaleModel(parts, modelData.scale)

        local container = Instance.new("Model")
        container.Name = "Free9entsModelChanger"
        container:SetAttribute(TAG, true)
        container.Parent = workspace

        for _, p in ipairs(parts) do
            p.Parent = container
        end

        container:PivotTo(root.CFrame)
        ModelChanger._container = container

        if _G.chamsEnabled then _G.applyChams(container) end

        if renderConn then renderConn:Disconnect() end
        renderConn = SA_Run.RenderStepped:Connect(function()
            if not enabled then return end
            local currentChar = SA_LP.Character
            local currentRoot = currentChar and getAnchor(currentChar)
            if not currentChar or not currentRoot or not container.Parent then
                if renderConn then renderConn:Disconnect() renderConn = nil end
                if container then container:Destroy() end
                if ModelChanger._container == container then ModelChanger._container = nil end
                return
            end
            local currentHumanoid = currentChar:FindFirstChildOfClass("Humanoid")
            if not currentHumanoid or currentHumanoid.Health <= 0 then
                if renderConn then renderConn:Disconnect() renderConn = nil end
                if container then container:Destroy() end
                if ModelChanger._container == container then ModelChanger._container = nil end
                return
            end
            container:PivotTo(currentRoot.CFrame)
        end)

        local diedConn = humanoid.Died:Connect(function()
            if renderConn then renderConn:Disconnect() renderConn = nil end
            if container then container:Destroy() end
            if ModelChanger._container == container then ModelChanger._container = nil end
        end)
        table.insert(connections, diedConn)

        asset:Destroy()
        print("[ModelChanger] Attached " .. modelData.name .. " (" .. #parts .. " parts, scale " .. modelData.scale .. ").")
        equipDebounce = false
    end

    local function onCharacterAdded(character)
        if not enabled then return end
        task.wait(0.5)
        if enabled then equip(character) end
    end

    local function startMaintenance()
        if maintenanceConn then return end
        maintenanceConn = SA_Run.Heartbeat:Connect(function()
            if not enabled then return end
            local char = SA_LP.Character
            if not char then return end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then return end

            rehideAvatar(char)

            if not ModelChanger._container or not ModelChanger._container.Parent then
                if not equipDebounce then
                    task.spawn(equip, char)
                end
            end
        end)
    end

    ModelChanger.start = function()
        if enabled then return end
        enabled = true
        if SA_LP.Character then
            task.spawn(equip, SA_LP.Character)
        end
        local conn = SA_LP.CharacterAdded:Connect(onCharacterAdded)
        table.insert(connections, conn)
        startMaintenance()
        print("[ModelChanger] Loaded.")
    end

    ModelChanger.stop = function()
        if not enabled then return end
        enabled = false
        if renderConn then renderConn:Disconnect() renderConn = nil end
        if maintenanceConn then maintenanceConn:Disconnect() maintenanceConn = nil end
        if ModelChanger._container then
            _G.resetChams(ModelChanger._container)
            ModelChanger._container:Destroy()
            ModelChanger._container = nil
        end
        for _, d in ipairs(workspace:GetChildren()) do
            if d:GetAttribute(TAG) then d:Destroy() end
        end
        if SA_LP.Character then
            clearOld(SA_LP.Character)
            restoreAvatar()
        end
        for _, conn in ipairs(connections) do conn:Disconnect() end
        connections = {}
    end

    ModelChanger.setModel = function(name)
