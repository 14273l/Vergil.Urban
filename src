            CM.OriginalBloomScale = cfg.Global.BloomScale
        end
    end
    if not CM.ClientState and weapons:FindFirstChild("ClientState") then
        local ok, cs = pcall(require, weapons.ClientState)
        if ok then CM.ClientState = cs end
    end
