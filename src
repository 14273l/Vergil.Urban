local Ambient = (function()
    local Lighting = game:GetService("Lighting")

    local Config = {
        Enabled        = false,
        Ambient        = Color3.fromRGB(80, 80, 80),
        OutdoorAmbient = Color3.fromRGB(128, 128, 128),
        Brightness     = 2,
        ClockTime      = 14,
        FogStart       = 0,
        FogEnd         = 1000,
        FogColor       = Color3.fromRGB(192, 192, 192),
        AtmosEnabled   = false,
        AtmosDensity   = 0.3,
        AtmosOffset    = 0,
        AtmosGlare     = 0,
        AtmosHaze      = 0,
        AtmosColor     = Color3.fromRGB(199, 199, 199),
        AtmosDecay     = Color3.fromRGB(106, 112, 125),
    }

    local Original     = {}
    local Atmos        = nil
    local CreatedAtmos = false

    local function SaveOriginal()
        if Original.Saved then return end
        Original.Ambient        = Lighting.Ambient
        Original.OutdoorAmbient = Lighting.OutdoorAmbient
        Original.Brightness     = Lighting.Brightness
        Original.ClockTime      = Lighting.ClockTime
        Original.FogStart       = Lighting.FogStart
        Original.FogEnd         = Lighting.FogEnd
        Original.FogColor       = Lighting.FogColor
        Original.Saved          = true
    end

    local function GetAtmos()
        if Atmos and Atmos.Parent then return Atmos end
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("Atmosphere") then
                Atmos = child
                return Atmos
            end
        end
        Atmos = Instance.new("Atmosphere")
        Atmos.Parent = Lighting
        CreatedAtmos = true
        return Atmos
    end

    function Config.Apply()
        if not Config.Enabled then return end
        SaveOriginal()
        Lighting.Ambient        = Config.Ambient
        Lighting.OutdoorAmbient = Config.OutdoorAmbient
        Lighting.Brightness     = Config.Brightness
        Lighting.ClockTime      = Config.ClockTime
        Lighting.FogStart       = Config.FogStart
        Lighting.FogEnd         = Config.FogEnd
        Lighting.FogColor       = Config.FogColor
    end

    function Config.Restore()
        if not Original.Saved then return end
        Lighting.Ambient        = Original.Ambient
        Lighting.OutdoorAmbient = Original.OutdoorAmbient
        Lighting.Brightness     = Original.Brightness
        Lighting.ClockTime      = Original.ClockTime
        Lighting.FogStart       = Original.FogStart
        Lighting.FogEnd         = Original.FogEnd
        Lighting.FogColor       = Original.FogColor
    end

    function Config.ApplyAtmos()
        if not Config.AtmosEnabled then
            if CreatedAtmos and Atmos and Atmos.Parent then
                Atmos:Destroy()
                Atmos = nil
                CreatedAtmos = false
            end
            return
        end
        local a = GetAtmos()
        a.Density = Config.AtmosDensity
        a.Offset  = Config.AtmosOffset
        a.Glare   = Config.AtmosGlare
        a.Haze    = Config.AtmosHaze
        a.Color   = Config.AtmosColor
        a.Decay   = Config.AtmosDecay
    end

    return Config
end)()

local Rain = (function()
    local RunService = game:GetService("RunService")

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "VergilRainPart" then obj:Destroy() end
    end

    local Config = {
        Enabled          = false,
        Rate             = 50,
        Lifetime         = 2.5,
        Speed            = 0,
        Size             = 1,
        Color            = Color3.fromRGB(30, 184, 255),
        HeightFromCamera = 75,
        AreaSize         = 75,
        AccelY           = -30,
        Texture          = "rbxassetid://7216855914",
        LockedToPart     = false,
        LightEmission    = 1,
        LightInfluence   = 0,
        Drag             = 0,
    }

    local Part, Emitter, HBConn

    local function UpdateEmitter()
        if not Emitter then return end
        Emitter.Enabled         = Config.Enabled
        Emitter.Texture         = Config.Texture
        Emitter.Size            = NumberSequence.new(Config.Size)
        Emitter.Orientation     = Enum.ParticleOrientation.VelocityParallel
        Emitter.Color           = ColorSequence.new(Config.Color, Config.Color)
        Emitter.LightEmission   = Config.LightEmission
        Emitter.LightInfluence  = Config.LightInfluence
        Emitter.Squash          = NumberSequence.new(0)
        Emitter.Transparency    = NumberSequence.new(0)
        Emitter.Lifetime        = NumberRange.new(Config.Lifetime * 0.8, Config.Lifetime * 1.2)
        Emitter.Rate            = Config.Rate
        Emitter.Rotation        = NumberRange.new(90, 90)
        Emitter.RotSpeed        = NumberRange.new(0, 0)
        Emitter.Speed           = NumberRange.new(Config.Speed, Config.Speed)
        Emitter.Acceleration    = Vector3.new(0, Config.AccelY, 0)
        Emitter.Drag            = Config.Drag
        Emitter.LockedToPart    = Config.LockedToPart
        if Part then
            Part.Size = Vector3.new(Config.AreaSize, 0.01, Config.AreaSize)
        end
    end

    local function Create()
        if Part and Part.Parent then return end
        if Part then Part:Destroy(); Part = nil end
        Emitter = nil

        Part = Instance.new("Part")
        Part.Name         = "VergilRainPart"
        Part.Anchored     = true
        Part.CanCollide   = false
        Part.CanQuery     = false
        Part.CanTouch     = false
        Part.CastShadow   = false
        Part.Transparency = 1
        Part.Size         = Vector3.new(Config.AreaSize, 0.01, Config.AreaSize)
        Part.Parent       = workspace

        Emitter = Instance.new("ParticleEmitter")
        Emitter.Parent = Part

        local cam = workspace.CurrentCamera
        if cam then
            Part.Position = cam.CFrame.Position + Vector3.new(0, Config.HeightFromCamera, 0)
        end

        UpdateEmitter()

        if HBConn then HBConn:Disconnect() end
        HBConn = RunService.Heartbeat:Connect(function()
            if not Config.Enabled then return end
            if not Part or not Part.Parent then return end
            local c = workspace.CurrentCamera
            if c then
                Part.Position = c.CFrame.Position + Vector3.new(0, Config.HeightFromCamera, 0)
            end
        end)
    end

    local function Destroy()
        if HBConn then HBConn:Disconnect(); HBConn = nil end
        if Part then Part:Destroy(); Part = nil end
        Emitter = nil
    end

    function Config.Start() Create() end
    function Config.Stop()  Destroy() end
    function Config.Update()
        if Config.Enabled then
            if not Part or not Part.Parent then Create() end
            UpdateEmitter()
        else
            Destroy()
        end
    end

    return Config
end)()

local SpinBot = (function()
    local RunService = game:GetService("RunService")
    local Players    = game:GetService("Players")
    local LP         = Players.LocalPlayer

    local Config = {
        Enabled  = false,
        Speed    = 20,
        Axis     = "Y",
        Preserve = true,
    }

    local Conn = nil

    local function MakeRotation(dt)
        local r = Config.Speed * dt
        if Config.Axis == "Y" then
            return CFrame.Angles(0, r, 0)
        elseif Config.Axis == "X" then
            return CFrame.Angles(r, 0, 0)
        elseif Config.Axis == "Z" then
            return CFrame.Angles(0, 0, r)
        else
            return CFrame.Angles(r * 0.6, r, r * 0.4)
        end
    end

    local function Step(dt)
        if not Config.Enabled then return end
        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end

        local vel = Config.Preserve and hrp.AssemblyLinearVelocity or nil
        hrp.CFrame = hrp.CFrame * MakeRotation(dt)
        if vel then
            pcall(function() hrp.AssemblyLinearVelocity = vel end)
        end
    end

    function Config.Start()
        if Conn then return end
        Conn = RunService.RenderStepped:Connect(Step)
    end

    function Config.Stop()
        if Conn then Conn:Disconnect(); Conn = nil end
    end

    return Config
end)()

local AntiAim = (function()
    local RunService = game:GetService("RunService")
    local Players    = game:GetService("Players")
    local LP         = Players.LocalPlayer

    local Config = {
        Enabled  = false,
        Mode     = "Jitter",
        Yaw      = 90,
        Pitch    = 0,
        Interval = 0.05,
        Preserve = true,
    }

    local Conn, CharConn = nil, nil
    local baseRotation = nil
    local elapsed, lastUpdate = 0, 0
    local jitterSign = 1
    local curYaw, curPitch = 0, 0

    local function GetHRP()
        local c = LP.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function GetHumanoid()
        local c = LP.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function UpdateOffsets()
        if Config.Mode == "Jitter" then
            jitterSign = -jitterSign
            curYaw = Config.Yaw * jitterSign
            curPitch = 0
        elseif Config.Mode == "Random" then
            curYaw   = (math.random() * 2 - 1) * Config.Yaw
            curPitch = 0
        elseif Config.Mode == "Static" then
            curYaw   = Config.Yaw
            curPitch = 0
        elseif Config.Mode == "Pitch" then
            curYaw   = 0
            curPitch = Config.Pitch
        elseif Config.Mode == "Yaw+Pitch" then
            curYaw   = (math.random() * 2 - 1) * Config.Yaw
            curPitch = (math.random() * 2 - 1) * Config.Pitch
        end
    end

    local function Step(dt)
        if not Config.Enabled then return end
        elapsed = elapsed + dt
        if elapsed - lastUpdate >= Config.Interval then
            lastUpdate = elapsed
            UpdateOffsets()
        end

        local hrp = GetHRP()
        if not hrp then return end
        local hum = GetHumanoid()
        if not hum or hum.Health <= 0 then return end

        if not baseRotation then
            baseRotation = hrp.CFrame.Rotation
        end

        local aaOffset = CFrame.Angles(math.rad(curPitch), math.rad(curYaw), 0)
        local vel = Config.Preserve and hrp.AssemblyLinearVelocity or nil

        hrp.CFrame = CFrame.new(hrp.Position) * baseRotation * aaOffset

        if vel then
            pcall(function() hrp.AssemblyLinearVelocity = vel end)
        end
    end

    local function OnChar(char)
        baseRotation = nil
        local hum = char:WaitForChild("Humanoid", 5)
        if hum and Config.Enabled then
            hum.AutoRotate = false
        end
        task.wait(0.1)
        if Config.Enabled then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then baseRotation = hrp.CFrame.Rotation end
        end
    end

    function Config.Start()
        if Conn then return end
        local hum = GetHumanoid()
        if hum then hum.AutoRotate = false end
        local hrp = GetHRP()
        if hrp then baseRotation = hrp.CFrame.Rotation end
        elapsed, lastUpdate, jitterSign = 0, 0, 1
        curYaw, curPitch = 0, 0
        Conn = RunService.RenderStepped:Connect(Step)
        CharConn = LP.CharacterAdded:Connect(OnChar)
    end

    function Config.Stop()
        if Conn then Conn:Disconnect(); Conn = nil end
        if CharConn then CharConn:Disconnect(); CharConn = nil end
        local hum = GetHumanoid()
        if hum then hum.AutoRotate = true end
        baseRotation = nil
    end

    return Config
end)()

