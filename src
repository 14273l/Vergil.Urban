local function CM_ApplyNoRecoil(enabled)
    if not CM.ClientState then CM_Resolve() end
    local cs = CM.ClientState
    if not cs then return end
    local key = cs.RecoilKey()
    if not key then return end
    if enabled then
        if not CM.OriginalRecoilFn then
            CM.OriginalRecoilKey = key
            CM.OriginalRecoilFn  = cs[key]
        end
        cs[key] = function() end
    else
        if CM.OriginalRecoilKey and CM.OriginalRecoilFn then
            cs[CM.OriginalRecoilKey] = CM.OriginalRecoilFn
        end
    end
end

local function CM_ApplyNoSpread(enabled)
    if not CM.Config then CM_Resolve() end
    if not CM.Config then return end
    if enabled then
        CM.Config.Global.BloomScale = 0
    else
        CM.Config.Global.BloomScale = CM.OriginalBloomScale or 1
