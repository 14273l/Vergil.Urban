Mods:Toggle({
    Name = "no spread", Flag = "cm_nospread", Default = false,
    Callback = function(v)
        CombatMods.NoSpread = v
        if v then CM_Resolve() end
        CM_ApplyNoSpread(v)
    end,
})

Mods:Toggle({
    Name = "instant reload", Flag = "cm_instant_reload", Default = false,
    Callback = function(v)
        CombatMods.InstantReload = v
        local gtOk, gt = pcall(function()
            return require(SA_RS:WaitForChild("Weapons"):WaitForChild("GunTuning"))
        end)
        if gtOk and gt then
            pcall(function() gt.InstantReload(v) end)
            pcall(function() gt.Apply() end)
        end

        -- Force the client's reload state to be cleared while enabled
        if v then
            if not CM.ClientState then CM_Resolve() end
            local cs = CM.ClientState
            if cs then
                cs.Reloading   = false
                cs.ReloadStart = 0
                cs.CanReload   = function() return true end
            end

            -- Avoid setting obvious globals; rely on attribute cleanup only
            print("[CM] Instant reload enabled")
        else
            if not CM.ClientState then CM_Resolve() end
            local cs = CM.ClientState
            if cs then
                cs.CanReload = function() return true end
            end
            print("[CM] Instant reload disabled")
        end
    end,
})

