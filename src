local SpinSection = Misc:Section({ Name = "spin bot", Side = 1 })

local spinToggle = SpinSection:Toggle({
    Name = "enabled", Flag = "spin_enabled", Default = false,
    Callback = function(v)
        SpinBot.Enabled = v
        if v then
            SpinBot.Start()
            if AntiAim.Enabled then
                AntiAim.Enabled = false
                AntiAim.Stop()
                if aaToggleRef and aaToggleRef.Set then
                    pcall(function() aaToggleRef:Set(false) end)
                end
            end
        else
            SpinBot.Stop()
        end
    end,
})
spinToggleRef = spinToggle

